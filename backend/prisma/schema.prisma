// backend/prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String   @unique
  password            String
  role                String   @default("admin") 
  active              Boolean  @default(true)
  permissions         String   @default("")
  maxDiscountPercent  Float?
  createdAt           DateTime @default(now())
}

model ShopSettings {
  id                Int      @id @default(autoincrement())
  shopName          String
  legalName         String?
  address1          String
  address2          String?
  city              String?
  state             String?
  phone             String?
  email             String?
  
  // UAE Currency Configuration Default
  currencyCode      String   @default("AED") 
  currencySymbol    String   @default("AED")
  
  // UAE Tax Compliance (VAT replacing GST)
  vatEnabled        Boolean  @default(true)
  trn               String?  // Tax Registration Number (15-digit UAE format)
  defaultTaxRate    Float    @default(5)  // Default 5% Standard Rate VAT
  
  // Loyalty
  loyaltyEnabled    Boolean  @default(false)
  pointsPerUnit     Float    @default(0) 
  pointValue        Float    @default(0) 
  
  // Receipt Customisation
  receiptHeader     String?
  receiptFooter     String   @default("Thank You! Visit Again.")
  showVat           Boolean  @default(true)
  autoPrintReceipt  Boolean  @default(false)
  usbPrinterWidth   Int      @default(80)
  autoPrintMethod   String   @default("browser")
  
  // Inventory
  lowStockAlert     Int      @default(5)
  allowNegativeStock Boolean  @default(false)
  pincode           String?
  signatureFile     String?
  signatoryName     String?
  invoiceLayout     String   @default("receipt")
  upiId             String?
  termsText         String?
  serialTracking    Boolean  @default(false)
  cashDrawer        Boolean  @default(false) 
  terminalProvider  String   @default("none") 
  terminalConfigEnc String?
  fxRates           String?
  fxUpdatedAt       DateTime?
  reportEmail       String?
  reportFrequency   String   @default("off") 
  reportLastSentAt  DateTime?
  smtpConfigEnc     String?
  syncRole          String   @default("none") 
  syncHubUrl        String?
  syncBranchCode    String?
  syncSecretEnc     String?
  syncLastAt        DateTime?
}

model Product {
  id             Int                 @id @default(autoincrement())
  barcode        String              @unique
  sku            String?             @unique
  name           String
  category       String?
  hsn            String?
  unit           String? 
  purchasePrice  Float
  sellingPrice   Float
  taxRate        Float               @default(5) // Default 5% UAE VAT
  discountType   String?       
  discountValue  Float               @default(0) 
  stock          Float               @default(0) 
  trackSerial    Boolean             @default(false)
  warrantyMonths Int                 @default(0)
  reorderPoint   Float               @default(0) 
  supplierId     Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  invoiceItems   InvoiceItem[]
  returnItems    ReturnItem[]
  serials        SerialUnit[]
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  poItems        PurchaseOrderItem[]

  @@index([name])
  @@index([category])
}

model SerialUnit {
  id             Int          @id @default(autoincrement())
  productId      Int
  serial         String       @unique
  status         String       @default("SOLD") 
  invoiceItemId  Int?
  soldAt         DateTime?
  warrantyEndsAt DateTime?
  note           String?
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id])
  invoiceItem    InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  events         SerialEvent[]

  @@index([productId, status])
  @@index([invoiceItemId])
}

model SerialEvent {
  id        Int        @id @default(autoincrement())
  serialId  Int
  type      String 
  invoiceId Int?
  note      String?
  createdAt DateTime   @default(now())
  serial    SerialUnit @relation(fields: [serialId], references: [id], onDelete: Cascade)

  @@index([serialId])
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String    @unique
  email         String?
  loyaltyPoints Int       @default(0)
  totalSpent    Float     @default(0)
  totalDue      Float     @default(0) 
  creditBalance Float     @default(0) 
  visits        Int       @default(0)
  trn           String?   // Changed from gstin to trn for corporate clients
  cardUid       String?   @unique
  createdAt     DateTime  @default(now())
  invoices      Invoice[]
  duePayments   CustomerDuePayment[]
  returns       Return[]
}

